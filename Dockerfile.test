FROM node:22-bookworm-slim AS frontend
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/src.jsx ./src.jsx
COPY frontend/wind.mjs ./wind.mjs
COPY frontend/beacon.mjs ./beacon.mjs
RUN npm run build

FROM ghcr.io/soaqa/tg_drop_bot:v0.17.0
COPY src /app/src
COPY --from=frontend /src/tg_drop_bot/static/frog/assets/app.js /app/src/tg_drop_bot/static/frog/assets/app.js
